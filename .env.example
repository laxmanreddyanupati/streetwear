# -----------------------------------------------------------------------------
# STREETWEAR. — environment example
# Copy to `.env.local` for local development. Never commit real credentials.
# Only VITE_* values are exposed to the browser. Server secrets must NEVER use
# the VITE_ prefix and must live in Firebase Functions environment config or a
# managed secret store.
# -----------------------------------------------------------------------------

# App
VITE_APP_NAME=STREETWEAR.
VITE_APP_URL=http://127.0.0.1:5173
VITE_COMMERCE_MODE=demo

# Asset base (leave empty to use bundled /images)
VITE_IMAGE_BASE_URL=

# Firebase (future phase — placeholders only, do NOT put private keys here)
VITE_FIREBASE_API_KEY=replace-with-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:replace
VITE_FIREBASE_APP_CHECK_SITE_KEY=replace-with-recaptcha-site-key
VITE_USE_FIREBASE_EMULATORS=false

# Server-only values (Firebase Functions secrets — never in Vite client code)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FIREBASE_SERVICE_ACCOUNT_JSON=
